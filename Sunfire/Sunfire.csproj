<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sunfire.Views/Sunfire.Views.csproj" />
    <ProjectReference Include="../../Wrath/Wrath.Views/Wrath.Views.csproj" />
    <ProjectReference Include="../Sunfire.FSUtils/Sunfire.FSUtils.csproj" />
    <ProjectReference Include="../../Moonfire/Moonfire.Tui/Moonfire.Tui.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="Scripts\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Previewers/" />
    <Folder Include="Views/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Piorum.GeoBlocker" Version="1.0.0-alpha" />
  </ItemGroup>

</Project>
