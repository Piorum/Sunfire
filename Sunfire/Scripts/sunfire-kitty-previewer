#!/usr/bin/env bash
exec 200>/tmp/sunfire-kitty-lock
flock 200 || exit 1
exec 2>/dev/null

# Wait a moment to prevent kitty from being overwhelmed (safe to remove once C# debounces/serializes)
sleep 0.01

set -euo pipefail
IFS=$'\n\t'

# Cell pixel dimensions (override via env vars or change the defaults here)
CELL_WIDTH_PX="${SUNFIRE_CELL_WIDTH_PX:-9}"
CELL_HEIGHT_PX="${SUNFIRE_CELL_HEIGHT_PX:-20}"

FILE_PATH="$1"
WIDTH="$2"
HEIGHT="$3"
POS_X="$4"
POS_Y="$5"

if (( WIDTH <= 0 || HEIGHT <= 0 )); then
    exit 0
fi

MAX_PX_W=$((WIDTH * CELL_WIDTH_PX))
MAX_PX_H=$((HEIGHT * CELL_HEIGHT_PX))
MAX_PREVIEW_DIMENSION="${MAX_PX_W}x${MAX_PX_H}>"
VIDEO_THUMB_SIZE=$(( MAX_PX_W > MAX_PX_H ? MAX_PX_W : MAX_PX_H ))

THUMBNAIL_FPATH="$SUNFIRE_KITTY_TEMPDIR/thumbnail.png"
mime=$(file --mime-type -Lb "$FILE_PATH")

wipe_pane() {
    # Tell Kitty to delete the graphics at this ID
    kitty-helper delete_img "$SUNFIRE_KITTY_IMAGE_ID" 1
}

wipe_pane

show_thumbnail() {
    kitty-helper show \
        "$THUMBNAIL_FPATH" \
        "$SUNFIRE_KITTY_IMAGE_ID" \
        1 \
        "$POS_X" \
        "$POS_Y" \
        "$WIDTH" \
        "$HEIGHT" \
        "$CELL_WIDTH_PX" \
        "$CELL_HEIGHT_PX"
}

case "$mime" in
image/png|image/jpeg|image/bmp|image/svg+xml|image/webp)
    gm convert "$FILE_PATH" -thumbnail "$MAX_PREVIEW_DIMENSION" -quality 10 "$THUMBNAIL_FPATH" || exit 0
    show_thumbnail
    ;;
image/gif)
    gm convert "${FILE_PATH}[0]" -thumbnail "$MAX_PREVIEW_DIMENSION" -quality 10 "$THUMBNAIL_FPATH" || exit 0
    show_thumbnail
    ;;
application/pdf)
    gs -o "$THUMBNAIL_FPATH" -sDEVICE=pngalpha -dLastPage=1 "$FILE_PATH" >/dev/null || exit 0
    show_thumbnail
    ;;
video/*)
    ffmpegthumbnailer -i "$FILE_PATH" -o "$THUMBNAIL_FPATH" -s "$VIDEO_THUMB_SIZE" >/dev/null || exit 0
    show_thumbnail
    ;;
text/*|application/json)
    expand -t 4 "$FILE_PATH" | head -n "$HEIGHT" | awk \
        -v x=$((POS_X + 1)) \
        -v y=$((POS_Y + 1)) \
        -v w="$WIDTH" \
        '{
            line = substr($0, 1, w)
            printf "\033[%d;%dH%s", y + (NR - 1), x, line
        }'
    ;;
*)
    msg="No preview available ($mime)"

    if (( ${#msg} > WIDTH )); then
        msg="${msg:0:WIDTH}"
    fi

    printf "\033[%d;%dH%s" $((POS_Y + 1)) $((POS_X + 1)) "$msg"
    ;;
esac

exit 0